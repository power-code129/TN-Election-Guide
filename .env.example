# ── TN Election Guide — Environment Variables ─────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ALL services below are FREE — no billing or payment required.

# ── FREE: Google Gemini API (AI Studio) ───────────────────────────────────
# Get your FREE key at: https://aistudio.google.com/app/apikey
# Free tier: 15 RPM, 1,500 requests/day, 1M tokens/min — NO billing required
# Leave empty to use static fallback (app works fully without this)
GEMINI_API_KEY=AIzaSyCR4u6DgBj5JmqOHD2Z8Qb2xOfkrVZEyKo

# ── Backend CORS ───────────────────────────────────────────────────────────
# Comma-separated allowed origins (your Firebase Hosting URL goes here)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# ── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# ── Server port ────────────────────────────────────────────────────────────
PORT=8080

# ── FREE: Google Analytics GA4 ────────────────────────────────────────────
# Get your FREE Measurement ID at: https://analytics.google.com
# Add it to frontend/index.html replacing G-XXXXXXXXXX
# No billing required — GA4 is 100% free
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Frontend API URL ───────────────────────────────────────────────────────
# Leave empty for local dev (Vite proxy handles /api → localhost:8000)
# Set to your backend URL for production
VITE_API_URL=
